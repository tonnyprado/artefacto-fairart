# API Backend
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:4000/api
#
# Production (Vercel):
# IMPORTANTE: Usa la URL PÚBLICA de Railway, NO la interna (.railway.internal)
# Ejemplo: NEXT_PUBLIC_API_URL=https://artefacto-fairart-production.up.railway.app/api
# Ver docs/RAILWAY_URL_FIX.md para más detalles

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=artefact_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Cloudinary (para subir archivos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SEO
NEXT_PUBLIC_SITE_URL=https://artefact-feria.com
NEXT_PUBLIC_SITE_NAME=ARTEFACT - Feria de Arte
NEXT_PUBLIC_SITE_DESCRIPTION=Descubre y conecta con artistas emergentes en la Feria de Arte ARTEFACT

# Admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@artefact-feria.com

# Email (para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@artefact-feria.com

# Analytics (opcional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
